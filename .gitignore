# ─── Gitignore Managed Directory ─────────────────────────
gitignore/

# ─── Old/unused files ─────────────────────────────────
*_previous.*
*.bak

# ─── IDE & Editor Configurations ─────────────────────────
.vscode/
.idea/
*.swp
*.swo
pyrefly.toml

# ─── OS Specific Files ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Firebase CLI Artifacts ──────────────────────────────
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ─── Environment & Secrets ───────────────────────────────
.env
.env.*
*.env
*.pem
*serviceAccount*.json
*service_account*.json
firebase_credentials*.json

# ─── Node & Python Cache ─────────────────────────────────
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ─── ai agents ─────────────────────────────────
.agents/
